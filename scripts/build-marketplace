#!/usr/bin/env python3
"""Regenerate .claude-plugin/marketplace.json from plugins/*/, and each
plugin.json's `skills` list from its skills/ folders (Codex needs the list).

Fails (exit 1) if a plugin or skill is malformed or contains a symlink, and
then writes nothing. With --check, writes nothing either way and fails when a
generated file is out of date.
"""
import json
import re
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
MARKETPLACE = {
    "name": "pluneto-skills",
    "owner": {"name": "Pluneto", "url": "https://github.com/Pluneto"},
    "description": "Pluneto's agent skills: plan and build workflows, engineering practice, skill authoring, design and UX reviews.",
}
FRONTMATTER = re.compile(r"\A---\n(.*?)\n---\n", re.S)


def frontmatter_keys(text):
    """Parsed frontmatter; raises yaml.YAMLError if it isn't valid YAML."""
    match = FRONTMATTER.match(text)
    keys = yaml.safe_load(match.group(1)) if match else None
    return keys if isinstance(keys, dict) else {}


def check_plugin(plugin_dir):
    errors = []
    for path in plugin_dir.rglob("*"):
        if path.is_symlink():
            errors.append(f"{path.relative_to(ROOT)}: symlinks are not allowed, copy the file")
    skills = sorted(p for p in (plugin_dir / "skills").glob("*") if p.is_dir())
    if not skills:
        errors.append(f"{plugin_dir.relative_to(ROOT)}: no skills/<name>/ folders")
    for skill in skills:
        skill_md = skill / "SKILL.md"
        if not skill_md.is_file():
            errors.append(f"{skill.relative_to(ROOT)}: missing SKILL.md")
            continue
        try:
            keys = frontmatter_keys(skill_md.read_text(encoding="utf-8"))
        except yaml.YAMLError as exc:
            errors.append(f"{skill_md.relative_to(ROOT)}: frontmatter is not valid YAML ({exc.problem})")
            continue
        if keys.get("name") != skill.name:
            errors.append(f"{skill_md.relative_to(ROOT)}: frontmatter name must be '{skill.name}'")
        if not keys.get("description"):
            errors.append(f"{skill_md.relative_to(ROOT)}: frontmatter needs a description")
    return errors


def plugin_manifest(plugin_dir):
    """(path, expected text, marketplace entry) for one plugin."""
    manifest_path = plugin_dir / ".claude-plugin" / "plugin.json"
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if manifest.get("name") != plugin_dir.name:
        raise ValueError(f"{plugin_dir.name}: plugin.json name must match the folder name")
    manifest["skills"] = [f"./skills/{p.name}" for p in sorted((plugin_dir / "skills").glob("*"))
                          if (p / "SKILL.md").is_file()]
    entry = {
        "name": plugin_dir.name,
        "source": f"./plugins/{plugin_dir.name}",
        "description": manifest.get("description", ""),
    }
    return manifest_path, json.dumps(manifest, indent=2) + "\n", entry


def expected_files():
    """(errors, {path: expected text}) for every generated file."""
    errors, files, entries = [], {}, []
    for plugin_dir in sorted(p for p in (ROOT / "plugins").glob("*") if p.is_dir()):
        errors += check_plugin(plugin_dir)
        try:
            path, text, entry = plugin_manifest(plugin_dir)
        except (OSError, ValueError) as exc:  # JSONDecodeError is a ValueError
            errors.append(str(exc))
            continue
        files[path] = text
        entries.append(entry)
    files[ROOT / ".claude-plugin" / "marketplace.json"] = json.dumps(
        {**MARKETPLACE, "plugins": entries}, indent=2) + "\n"
    return errors, files


def main(argv):
    errors, files = expected_files()
    if errors:
        print("build-marketplace: errors\n  " + "\n  ".join(errors), file=sys.stderr)
        return 1
    outdated = [p for p, text in files.items() if not p.is_file() or p.read_text(encoding="utf-8") != text]
    if "--check" in argv:
        if outdated:
            print("build-marketplace: out of date, run scripts/build-marketplace and stage:\n  "
                  + "\n  ".join(str(p.relative_to(ROOT)) for p in outdated), file=sys.stderr)
            return 1
        return 0
    for path in outdated:
        path.write_text(files[path], encoding="utf-8")
        print(f"build-marketplace: wrote {path.relative_to(ROOT)}")
    print(f"build-marketplace: ok ({len(files) - 1} plugin(s))")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

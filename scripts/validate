#!/usr/bin/env python3
"""Run `claude plugin validate --strict` on the marketplace and every plugin,
then the repo's own checks:

- every plugin.json has a version, and a plugin whose files differ from
  origin/main has a different version than origin/main (bump with scripts/bump)
- every skill has agents/openai.yaml, with allow_implicit_invocation: false
  exactly when SKILL.md has disable-model-invocation: true
- every skill copied from mattpocock/skills keeps its LICENSE
- every skill is named in the which-skill router (as a whole word)
- the generated marketplace files are current (scripts/build-marketplace --check)
- files kept as identical copies in several skills (PAIRED) still match
"""
import json
import re
import subprocess
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
FRONTMATTER = re.compile(r"\A---\n(.*?)\n---\n", re.S)
# Skills copied from mattpocock/skills (MIT): each folder must keep his LICENSE.
VENDORED = {"tdd", "diagnosing-bugs", "review-changes", "pr", "prototype", "codebase-design",
            "improve-codebase-architecture", "domain-modeling", "wayfinder", "to-tickets",
            "to-questionnaire", "wizard", "writing-for-agents", "handoff", "which-skill",
            "setup-pluneto-skills"}
ROUTER = ROOT / "plugins" / "workflow" / "skills" / "which-skill" / "SKILL.md"
# Files copied into several skills (no symlinks allowed): each group must stay identical.
PAIRED = [
    ["plugins/design/skills/user-types/scripts/ux.py", "plugins/design/skills/tool-for-users/scripts/ux.py"],
    ["plugins/design/skills/user-types/references/file-format.md",
     "plugins/design/skills/tool-for-users/references/file-format.md"],
    ["plugins/workflow/skills/to-tickets/no-tracker-doc.md", "plugins/workflow/skills/wayfinder/no-tracker-doc.md",
     "plugins/workflow/skills/build-this/no-tracker-doc.md"],
]


def problems(report):
    sections = [report.get("manifest") or {}] + list(report.get("contents") or [])
    for section in sections:
        for err in section.get("errors", []):
            yield f"error   {err.get('path', '')}: {err['message']}"
        for warn in section.get("warnings", []):
            yield f"warning {warn.get('path', '')}: {warn['message']}"


def git(*args):
    return subprocess.run(["git", "-C", str(ROOT), *args], capture_output=True, text=True)


def version_problems(plugin):
    rel = f"plugins/{plugin.name}"
    version = json.loads((plugin / ".claude-plugin" / "plugin.json").read_text()).get("version")
    if not version:
        return [f"{rel}: plugin.json needs a version"]
    base = git("show", f"origin/main:{rel}/.claude-plugin/plugin.json")
    if base.returncode != 0:  # new plugin, or origin/main not fetched
        return []
    changed = (git("diff", "--quiet", "origin/main", "--", rel).returncode != 0
               or bool(git("ls-files", "--others", "--exclude-standard", "--", rel).stdout.strip()))
    if changed and json.loads(base.stdout).get("version") == version:
        return [f"{rel}: files changed since origin/main but version is still {version}; run scripts/bump {plugin.name}"]
    return []


def skill_problems(skill):
    rel = skill.relative_to(ROOT)
    skill_md = skill / "SKILL.md"
    match = FRONTMATTER.match(skill_md.read_text(encoding="utf-8")) if skill_md.is_file() else None
    if not match:
        return [f"{rel}: SKILL.md is missing or has no frontmatter"]
    user_only = (yaml.safe_load(match.group(1)) or {}).get("disable-model-invocation") is True
    found = []
    meta_path = skill / "agents" / "openai.yaml"
    if not meta_path.is_file():
        found.append(f"{rel}: missing agents/openai.yaml")
    else:
        meta = yaml.safe_load(meta_path.read_text(encoding="utf-8")) or {}
        interface = meta.get("interface") or {}
        if not interface.get("display_name") or not interface.get("short_description"):
            found.append(f"{rel}: openai.yaml needs interface.display_name and short_description")
        implicit = (meta.get("policy") or {}).get("allow_implicit_invocation", True)
        if implicit == user_only:
            found.append(f"{rel}: openai.yaml allow_implicit_invocation must be {not user_only} "
                         f"(disable-model-invocation is {user_only})")
    if skill.name in VENDORED and not (skill / "LICENSE").is_file():
        found.append(f"{rel}: copied from mattpocock/skills, keep its LICENSE")
    named = re.compile(rf"(?<![\w-]){re.escape(skill.name)}(?![\w-])")
    if ROUTER.is_file() and skill.name != "which-skill" and not named.search(ROUTER.read_text(encoding="utf-8")):
        found.append(f"{rel}: not named in which-skill")
    return found


def cli_problems(target):
    """Problems from `claude plugin validate --strict` on one target."""
    try:
        run = subprocess.run(["claude", "plugin", "validate", "--strict", "--json", str(target)],
                             capture_output=True, text=True)
    except FileNotFoundError:
        return ["the claude CLI is not installed or not on PATH"]
    try:
        report = json.loads(run.stdout)
    except json.JSONDecodeError:
        return [f"claude plugin validate printed no JSON (exit {run.returncode}): {(run.stderr or run.stdout).strip()[:300]}"]
    found = list(problems(report))
    if (run.returncode != 0 or report.get("success") is False) and not found:
        found.append(f"claude plugin validate failed (exit {run.returncode}, success {report.get('success')})")
    return found


def repo_problems():
    found = []
    build = subprocess.run([sys.executable, str(ROOT / "scripts" / "build-marketplace"), "--check"],
                           capture_output=True, text=True)
    if build.returncode != 0:
        found.append(build.stderr.strip())
    for group in PAIRED:
        texts = {rel: (ROOT / rel).read_bytes() if (ROOT / rel).is_file() else None for rel in group}
        if None in texts.values() or len(set(texts.values())) > 1:
            found.append("these copies must be identical (edit all of them): " + ", ".join(group))
    return found


def main():
    plugins = sorted(p for p in (ROOT / "plugins").glob("*") if p.is_dir())
    failed = False
    for target in [ROOT] + plugins:
        found = cli_problems(target)
        if target == ROOT:
            found += repo_problems()
        else:
            found += version_problems(target)
            for skill in sorted(p for p in (target / "skills").glob("*") if p.is_dir()):
                found += skill_problems(skill)
        if found:
            failed = True
            print(f"{target.relative_to(ROOT) or '.'}:\n  " + "\n  ".join(found), file=sys.stderr)
    if not ROUTER.is_file():
        print("validate: note: which-skill doesn't exist yet, router check skipped", file=sys.stderr)
    print("validate: " + ("FAILED" if failed else f"ok ({len(plugins) + 1} targets)"))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
